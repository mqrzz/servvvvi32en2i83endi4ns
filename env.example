# Скопируй в .env и заполни реальными значениями на сервере
# НИКОГДА не коммить .env в git!

# PostgreSQL
DATABASE_URL=postgres://antviz:ПАРОЛЬ@localhost:5432/antviz

# JWT (сгенерировать случайную длинную строку, например: openssl rand -hex 64)
JWT_SECRET=замени_на_случайную_длинную_строку

# Почта для отправки кодов (SMTP). Можно Yandex, Mail.ru, или сервис типа Resend.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@antviz.ru
SMTP_PASS=пароль_приложения
MAIL_FROM="Antviz <noreply@antviz.ru>"

# Порт, на котором слушает backend (nginx будет проксировать сюда)
PORT=3000

# Секрет для проверки вебхука оплаты от Vercel (сгенерировать: openssl rand -hex 32)
PAYMENT_WEBHOOK_SECRET=замени_на_случайную_строку

# Домен фронтенда (для CORS)
FRONTEND_ORIGIN=https://antviz.ru
